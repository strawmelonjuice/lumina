{application, collie, [
    {vsn, "1.0.0"},
    {applications, [exception,
                    gleam_crypto,
                    gleam_erlang,
                    gleam_http,
                    gleam_otp,
                    gleam_stdlib,
                    logging,
                    ssl,
                    websocks]},
    {description, "🐕 Websocket client in Gleam"},
    {modules, [collie,
               collie@@main,
               collie@internal@http,
               collie@internal@socket,
               collie_ffi]},
    {registered, []}
]}.
