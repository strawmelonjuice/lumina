{application, parrot, [
    {vsn, "2.2.1"},
    {applications, [argv,
                    envoy,
                    filepath,
                    gleam_crypto,
                    gleam_httpc,
                    gleam_json,
                    gleam_stdlib,
                    gleam_time,
                    glearray,
                    repeatedly,
                    simplifile,
                    tom]},
    {description, "🦜 type-safe SQL in gleam for sqlite, postgresql & mysql"},
    {modules, [parrot,
               parrot@@main,
               parrot@dev,
               parrot@internal@cli,
               parrot@internal@codegen,
               parrot@internal@config,
               parrot@internal@db,
               parrot@internal@errors,
               parrot@internal@lib,
               parrot@internal@project,
               parrot@internal@shellout,
               parrot@internal@spinner,
               parrot@internal@sqlc,
               parrot@internal@string_case,
               parrot_ffi]},
    {registered, []}
]}.
