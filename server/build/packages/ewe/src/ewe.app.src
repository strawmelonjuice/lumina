{application, ewe, [
    {mod, {'ewe@internal@clock', []}},
    {vsn, "3.0.7"},
    {applications, [compresso,
                    exception,
                    gleam_erlang,
                    gleam_http,
                    gleam_otp,
                    gleam_stdlib,
                    glisten,
                    logging,
                    websocks]},
    {description, "🐑 a fluffy Gleam web server"},
    {modules, [ewe,
               ewe@@main,
               ewe@internal@clock,
               ewe@internal@decoder,
               ewe@internal@encoder,
               ewe@internal@file,
               ewe@internal@handler,
               ewe@internal@http1,
               ewe@internal@http1@buffer,
               ewe@internal@http1@handler,
               ewe@internal@stream@chunked,
               ewe@internal@stream@sse,
               ewe@internal@stream@websocket,
               ewe_ffi]},
    {registered, []}
]}.
